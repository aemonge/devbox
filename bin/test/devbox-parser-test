    rm -f -- "${CAPTURE}"
    run_devbox_process "${devbox_entry}" "$@" >/dev/null
    mapfile -d '' -t BWRAP_ARGS <"${CAPTURE}"
}

assert_devbox_failure() {
    local description="$1"
    local expected_message="$2"
    shift 2
    local output
    local status

    rm -f -- "${CAPTURE}"
    if output="$(run_devbox_process "${DEVBOX}" "$@" 2>&1)"; then
        status=0
    else
        status=$?
    fi
    if [[ "${status}" -ne 0 && "${output}" == *"${expected_message}"* && ! -e "${CAPTURE}" ]]; then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi
    printf 'FAIL: %s (status=%s, output=%s)\n' "${description}" "${status}" "${output}" >&2
    exit 1
}

assert_sequence_contains() {
    local description="$1"
    shift
    local -a expected=("$@")
    local i j matched
    for ((i = 0; i <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; i++)); do
        matched=1
        for ((j = 0; j < ${#expected[@]}; j++)); do
            [[ "${BWRAP_ARGS[i + j]}" == "${expected[j]}" ]] || {
                matched=0
                break
            }
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'PASS: %s\n' "${description}"
            return 0
        fi
    done
    printf 'FAIL: %s (missing sequence:' "${description}" >&2
    printf ' %q' "${expected[@]}" >&2
    printf ')\n' >&2
    exit 1
}

assert_sequence_absent() {
    local description="$1"
    shift
    local -a expected=("$@")
    local i j matched
    for ((i = 0; i <= ${#BWRAP_ARGS[@]} - ${#expected[@]}; i++)); do
        matched=1
        for ((j = 0; j < ${#expected[@]}; j++)); do
            [[ "${BWRAP_ARGS[i + j]}" == "${expected[j]}" ]] || {
                matched=0
                break
            }
        done
        if [[ "${matched}" -eq 1 ]]; then
            printf 'FAIL: %s (unexpected sequence:' "${description}" >&2
            printf ' %q' "${expected[@]}" >&2
            printf ')\n' >&2
            exit 1
        fi
    done
    printf 'PASS: %s\n' "${description}"
}

# A superseded same-destination read-only mount stays in argv; the writable
# mount must be applied AFTER it, because bwrap stacks mounts in argv order.
assert_sequence_shadows() {
    local description="$1"
    shift
    local -a superseded=("$1" "$2")
    local -a shadowing=("$3" "$4")
    local superseded_index=-1 shadowing_index=-1
    local i
    for ((i = 0; i <= ${#BWRAP_ARGS[@]} - 2; i++)); do
        if [[ "${BWRAP_ARGS[i]}" == "${superseded[0]}" && "${BWRAP_ARGS[i + 1]}" == "${superseded[1]}" ]]; then
            superseded_index="$i"
        fi
        if [[ "${BWRAP_ARGS[i]}" == "${shadowing[0]}" && "${BWRAP_ARGS[i + 1]}" == "${shadowing[1]}" ]]; then
            shadowing_index="$i"
        fi
    done
    if [[ "${superseded_index}" -ge 0 && "${shadowing_index}" -gt "${superseded_index}" ]]; then
        printf 'PASS: %s\n' "${description}"
        return 0
    fi
    printf 'FAIL: %s (superseded_index=%s, shadowing_index=%s)\n' "${description}" "${superseded_index}" "${shadowing_index}" >&2
    exit 1
}

assert_bind_destination_absent() {
    local description="$1"
    local expected_destination="$2"
    local index flag destination

    for ((index = 0; index < ${#BWRAP_ARGS[@]}; index++)); do
        flag="${BWRAP_ARGS[index]}"
        case "${flag}" in
        --bind | --ro-bind)
            destination="${BWRAP_ARGS[index + 2]:-}"
            if [[ "${destination}" == "${expected_destination}" ]]; then
                printf 'FAIL: %s (unexpected %s destination)\n' "${description}" "${flag}" >&2
                exit 1
            fi
            index=$((index + 2))
            ;;
        esac
    done
    printf 'PASS: %s\n' "${description}"
}

assert_no_conflicting_bind_destinations() {
    local description="$1"
    local index flag destination previous
    local -A destination_modes=()

    for ((index = 0; index < ${#BWRAP_ARGS[@]}; index++)); do
        flag="${BWRAP_ARGS[index]}"
        case "${flag}" in
        --bind | --ro-bind)
            destination="${BWRAP_ARGS[index + 2]:-}"
            previous="${destination_modes[${destination}]:-}"
            if [[ -n "${previous}" && "${previous}" != "${flag}" ]]; then
                printf 'FAIL: %s (%s has %s and %s)\n' "${description}" "${destination}" "${previous}" "${flag}" >&2
                exit 1
            fi
            destination_modes[${destination}]="${flag}"
            index=$((index + 2))
            ;;
        esac
    done
    printf 'PASS: %s\n' "${description}"
}

assert_tail() {
    local description="$1"
    shift
    local -a expected=("$@")
    local start=$((${#BWRAP_ARGS[@]} - ${#expected[@]}))
    local i
    for ((i = 0; i < ${#expected[@]}; i++)); do
        if [[ "${BWRAP_ARGS[start + i]}" != "${expected[i]}" ]]; then
            printf 'FAIL: %s\n' "${description}" >&2
            exit 1
        fi
    done
    printf 'PASS: %s\n' "${description}"
}

get_setenv_value() {
    local name="$1"
    local value=""
    local index

    for ((index = 0; index < ${#BWRAP_ARGS[@]} - 2; index++)); do
        if [[ "${BWRAP_ARGS[index]}" == --setenv && "${BWRAP_ARGS[index + 1]}" == "${name}" ]]; then
            value="${BWRAP_ARGS[index + 2]}"
        fi
    done
    [[ -n "${value}" ]] || return 1
    printf '%s\n' "${value}"
}

